<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="22sp" android:textStyle="bold"
        android:paddingBottom="4dp"/>
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/subtitle" android:paddingBottom="20dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/server_label"/>
    <EditText android:id="@+id/url"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textUri" android:hint="http://192.168.15.11:7900"/>
    <Button android:id="@+id/saveUrl"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/save_server"/>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#33000000" android:layout_marginVertical="16dp"/>

    <Button android:id="@+id/overlay"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/grant_overlay"/>
    <Button android:id="@+id/start"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/start_capture"/>
    <Button android:id="@+id/stop"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/stop_service"/>

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/howto" android:paddingTop="20dp" android:textSize="13sp"/>
</LinearLayout>

# Copie para .env e ajuste se precisar. Defaults já servem pro seu servidor.
PORT=7900

# --- Whisper (transcrição) ---
# device=cpu funciona sempre. Só troque pra cuda se instalar o nvidia-container-toolkit.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- Ollama (tradução) roda no HOST, fora do container ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# --- Vozes ---
VOICE_MALE=male.onnx
VOICE_FEMALE=female.onnx
FEMALE_PITCH_FALLBACK=3.5
GENDER_F0_THRESHOLD=165
MAX_SPEEDUP=1.6
